# Copy this file to `.env` next to docker-compose.yml and fill in the values.
# `docker compose` reads it automatically. Never commit the real `.env`.

# --- required ---------------------------------------------------------------
# 32+ characters. Without it the server refuses to boot.
# Generate: openssl rand -hex 32
APP_SECRET=

# Password of the postgres container, also used in DATABASE_URL.
# Generate: openssl rand -hex 24
# NOTE: on an existing db_data volume this must match the password the database
# was initialised with (see README, "Existing database").
DB_PASSWORD=

# --- optional ---------------------------------------------------------------
APP_URL=http://localhost:3000

# Email: needed for invites and password resets.
# Without a mail server set MAIL_DRIVER=log (emails are written to the container
# logs instead of being sent) and leave the SMTP_* values empty.
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=docmost@example.com
MAIL_FROM_NAME=Docmost
